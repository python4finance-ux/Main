from datetime import date
import time


def download_vintages(series_id):
    records = []
    today = date.today()

    for year in range(1990, today.year + 1):
        start = f"{year}-01-01"
        end = min(f"{year}-12-31", today.isoformat())
        offset = 0

        while True:
            response = fred.observations(
                series_id,
                observation_start="1990-01-01",
                realtime_start=start,
                realtime_end=end,
                output_type=1,
                limit=100000,
                offset=offset,
            )

            root = response["observations"]

            if isinstance(root, dict):
                rows = root.get("observation", [])
                count = int(root.get("count", root.get("@count")))
            else:
                rows = root
                count = int(response["count"])

            if isinstance(rows, dict):
                rows = [rows]

            if not rows and offset < count:
                raise RuntimeError(f"Incomplete response: {series_id}")

            records.extend(rows)
            offset += len(rows)
            time.sleep(0.6)

            if offset >= count:
                break

    # A value may remain unchanged across several requested years.
    # Join those adjacent intervals to remove artificial year boundaries.
    records.sort(key=lambda r: (r["date"], r["realtime_start"]))
    merged = []

    for row in records:
        row = row.copy()

        if merged:
            previous = merged[-1]
            adjacent = (
                date.fromisoformat(row["realtime_start"]).toordinal()
                <= date.fromisoformat(
                    previous["realtime_end"]
                ).toordinal() + 1
            )

            if (
                row["date"] == previous["date"]
                and row["value"] == previous["value"]
                and adjacent
            ):
                previous["realtime_end"] = max(
                    previous["realtime_end"],
                    row["realtime_end"],
                )
                continue

        merged.append(row)

    data = pd.DataFrame(
        merged,
        columns=["date", "realtime_start", "realtime_end", "value"],
    ).rename(columns={
        "date": "observation_date",
        "realtime_start": "vintage_date",
        "realtime_end": "valid_until",
    })

    data["series_id"] = series_id
    data["value"] = pd.to_numeric(
        data["value"].replace(".", None), errors="raise"
    )

    return data[
        ["series_id", "observation_date",
         "vintage_date", "valid_until", "value"]
    ]